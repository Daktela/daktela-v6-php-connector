{
  "name": "daktela/daktela-v6-php-connector",
  "description": "Enables connecting to Daktela V6 installation REST API from PHP code",
  "minimum-stability": "stable",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Daktela",
      "email": "daktela@daktela.com"
    },
    {
      "name": "Jiri Havlicek",
      "email": "jiri.havlicek@daktela.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1",
    "guzzlehttp/psr7": "^2.13 || ^3.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13.6"
  },
  "autoload": {
    "psr-4": {
      "Daktela\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Daktela\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.dist.xml",
    "test:unit": "phpunit --configuration phpunit.dist.xml --testsuite Unit",
    "analyse": "phpstan analyse --no-progress",
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "check": [
      "@composer validate --strict --no-check-lock",
      "@cs",
      "@analyse",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "check": "Runs what CI runs: composer validate, coding standard, static analysis, and the tests"
  }
}
